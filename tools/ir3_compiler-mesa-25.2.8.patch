+static struct ir3_shader_variant *
+compile_nir(nir_shader *nir, gl_shader_stage stage)
+{
+   const struct ir3_shader_nir_options nir_options = {};
+   struct ir3_shader_key key = {};
+
+   ir3_nir_lower_io_vars_to_temporaries(nir);
+   ir3_finalize_nir(compiler, &nir_options, nir);
+
+   struct ir3_shader *shader =
+      ir3_shader_from_nir(compiler, nir, &(struct ir3_shader_options){
+                             .api_wavesize = IR3_SINGLE_OR_DOUBLE,
+                             .real_wavesize = IR3_SINGLE_OR_DOUBLE,
+                          }, NULL);
+
+   struct ir3_shader_variant *v = ir3_shader_create_variant(shader, &key, true);
+   if (!v)
+      errx(1, "compiler failed!");
+
+   printf("; %s: NIR compiler\n", ir3_shader_stage(v));
+   fputs(v->disasm_info.disasm, stdout);
+   dump_variant_summary(v);
+   dump_dwords(v, v->bin);
+   printf("\n");
+
+   if (v->binning) {
+      printf("; %s: BINNING VARIANT (VS used for the binning pass; position only)\n",
+             ir3_shader_stage(v));
+      fputs(v->binning->disasm_info.disasm, stdout);
+      dump_variant_summary(v->binning);
+      dump_dwords(v->binning, v->binning->bin);
+      printf("\n");
+   }
+
+   return v;
+}
