+
+/* Harness: a rail on in both sets at its voltage, in high-power mode.
+ * Without a voltage the RPM brings it back at its own minimum, below
+ * what the bootloader set (L4 1.15 V, L15 2.75 V). */
+int rpm_rail_on_hpm(uint32_t id, uint32_t uv)
+{
+	uint32_t kvp[6] = { RPM_KEY_LSMD, 4, 1, 0x7675, 4, uv };
+	int r = request(RPM_SET_ACTIVE, RPM_LDOA, id, kvp, 2);
+	if (!r)
+		r = request(RPM_SET_SLEEP, RPM_LDOA, id, kvp, 2);
+	return r ? r : rpm_regulator_both(RPM_LDOA, id, true);
+}
+
+/* Harness: the microSD supplies L18 (vdd) and L21 (vdd-io). Sturgeon has
+ * no slot and its kernel disables the controller, but they are on at
+ * boot; Linux leaves them off. Voted off in both sets, back on only if
+ * this turned them off. True once the request holds physically. */
+static bool sd_rail_off[2];
+bool rpm_sd_rails(bool off)
+{
+	static const uint8_t ids[2] = { 18, 21 };
+	bool ok = true, changed = false;
+	for (unsigned i = 0; i < 2; i++) {
+		if (sd_rail_off[i] == off)
+			continue;
+		changed = true;
+		if (rpm_regulator_both(RPM_LDOA, ids[i], !off))
+			ok = false;
+		else
+			sd_rail_off[i] = off;
+		/* Back on, in the high-power mode they had at boot. */
+		uint32_t kvp[3] = { RPM_KEY_LSMD, 4, 1 };
+		if (!off && (request(RPM_SET_ACTIVE, RPM_LDOA, ids[i], kvp, 1) || request(RPM_SET_SLEEP, RPM_LDOA, ids[i], kvp, 1)))
+			ok = false;
+	}
+	uint8_t en18 = pmic_read(0x015146), en21 = pmic_read(0x015446);
+	if (changed)
+		log_printf("rpm: sd supplies %s%s (l18 %02x, l21 %02x)\n", off ? "off" : "on", ok ? "" : " NOT all acknowledged",
+			   en18, en21);
+	bool phys_off = !(en18 & 0x80) && !(en21 & 0x80);
+	return ok && (off ? phys_off : true);
+}
