+		 * the measures that switch it (the RPM keeps each key's last value
+		 * per set). */
+		/* Off: the active mode again and no load request (0 mA), so
+		 * the low load left by "on" does not linger. */
+		uint32_t kvp[6] = { RPM_KEY_LSMD, 4, on ? 0 : lpm_active_hpm[i] > 0, RPM_KEY_MA, 4, on ? 1 : 0 };
+		if (request(RPM_SET_SLEEP, RPM_LDOA, lpm_ldos[i], kvp, 2))
+			ok = false;
+	}
+	if (ok)
+		ldo_sleep = on;
+	log_printf("rpm: ldo sleep votes %s%s\n", on ? "low power" : "as active", ok ? "" : " NOT all acknowledged");
+	return ok;
+}
+
+/* Harness: a rail switched in both sets, so a sleep-set vote from
+ * another measure cannot turn it back on while asleep. */
+int rpm_regulator_both(uint32_t type, uint32_t id, bool on)
+{
+	int r = rpm_regulator_enable(type, id, on);
+	return r ? r : rpm_regulator_sleep_enable(type, id, on);
