+			goto fail;
+		}
+		hc_ww((uint16_t)(hc_rw(HC_CLK) | CLK_SD_EN), HC_CLK);
+		card_asleep = false;
+		if ((r = cmd(5, RCA << 16, R1B, NULL)) || (r = cmd(7, RCA << 16, R1B, NULL)) || (r = wait_tran(1000))) {
+			card.ready = false;
+			goto fail;
+		}
