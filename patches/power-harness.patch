diff --git a/src/audio/speaker.c b/src/audio/speaker.c
index d2abd68..76f9c6b 100644
--- a/src/audio/speaker.c
+++ b/src/audio/speaker.c
@@ -29,3 +29,56 @@ int speaker_probe(uint16_t *rev)
 	bus = true;
 	return read_reg(REG_REV, rev);
 }
+
+/* Harness: register access, and the amplifier powered down (register 9,
+ * system control, bit 0) with the previous value put back after. */
+int speaker_read(uint8_t reg, uint16_t *val)
+{
+	uint16_t rev;
+	int r = speaker_probe(&rev);
+	return r ? r : read_reg(reg, val);
+}
+
+static int write_reg(uint8_t reg, uint16_t val)
+{
+	uint8_t b[3] = { reg, (uint8_t)(val >> 8), (uint8_t)val };
+	return i2c_qup_xfer(QUP, ADDR, b, 3, NULL, 0);
+}
+
+/* As the vendor's speaker-off (libexTfa98xx tfa98xx_stop): mute (reg 6
+ * bit 5 off, reg 9 amp and boost enables off), wait for the amplifier to
+ * stop switching (reg 0 bit 12), power down (reg 9 bit 0), AEC output off
+ * (reg 4 bit 11). The registers are put back as they were after. */
+static int update_reg(uint8_t reg, uint16_t clear, uint16_t set)
+{
+	uint16_t v;
+	int r = read_reg(reg, &v);
+	return r ? r : write_reg(reg, (uint16_t)((v & ~clear) | set));
+}
+
+bool speaker_powerdown(bool on)
+{
+	static bool down;
+	static uint16_t saved4, saved6, saved9;
+	if (on == down)
+		return true;
+	uint16_t v;
+	if (speaker_read(0x09, &v))
+		return false;
+	if (on) {
+		if (read_reg(0x04, &saved4) || read_reg(0x06, &saved6) || read_reg(0x09, &saved9))
+			return false;
+		if (update_reg(0x06, 0x20, 0) || update_reg(0x09, 0x18, 0))
+			return false;
+		for (int i = 0; i < 40 && !read_reg(0x00, &v) && (v & 0x1000); i++)
+			delay_ms(5);
+		if (update_reg(0x09, 0, 1) || update_reg(0x04, 0x800, 0))
+			return false;
+	} else if (write_reg(0x04, saved4) || write_reg(0x06, saved6) || write_reg(0x09, saved9)) {
+		return false;
+	}
+	read_reg(0x09, &v);
+	down = on;
+	log_printf("amp: %s, sys ctrl %04x\n", on ? "powered down" : "restored", v);
+	return true;
+}
