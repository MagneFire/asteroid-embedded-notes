 {
 	if (!card.ready)
 		return -1;
+	if (card_asleep && emmc_sleep(false))
+		return -1;
+	last_io_ms = time_ms();
 	if (!n || lba >= card.sectors || n > card.sectors - lba)
 		return -2;
 	uint8_t *p = buf;
@@ -615,6 +673,7 @@ static int xfer(uint32_t lba, uint32_t n, void *buf, bool read)
 		n -= k;
 		wdt_feed();
 	}
+	last_io_ms = time_ms();
 	return 0;
 }
 
