+/* Harness: sensor sleep as the vendor does it: attention masked, F01
+ * device control sleep mode 1 with NoSleep cleared; on wake the saved
+ * NoSleep bit returns, pending interrupt status is read and attention is
+ * unmasked. */
+static bool sensor_asleep;
+static uint8_t f01_ctrl_saved;
+bool touch_rmi4_sleep(bool on)
+{
+	if (!present)
+		return false;
+	if (on == sensor_asleep)
+		return true;
+	uint8_t v = 0, st[2];
+	if (on) {
+		tlmm_irq_enable(GPIO_ATTN, false);
+		if (rd(f01.ctrl, &v, 1) || wr(f01.ctrl, (uint8_t)((v & ~7) | 1)))
+			goto fail;
+		f01_ctrl_saved = v;
+	} else {
+		if (rd(f01.ctrl, &v, 1) || wr(f01.ctrl, (uint8_t)((v & ~7) | (f01_ctrl_saved & 4))))
+			goto fail;
+		rd(f01.data, st, 2);
+		tlmm_irq_enable(GPIO_ATTN, true);
+	}
+	sensor_asleep = on;
+	rd(f01.ctrl, &v, 1);
+	log_printf("touch: sensor %s, ctrl %02x\n", on ? "asleep" : "awake", v);
+	return true;
+fail:
+	if (!sensor_asleep)
+		tlmm_irq_enable(GPIO_ATTN, true);
+	log_printf("touch: sensor %s failed\n", on ? "sleep" : "wake");
+	return false;
+}
+
+/* Harness: the controller's supply L19 off (the vendor's non-gesture
+ * suspend; LVS1 for the pull-ups stays on), with the sensor asleep and
+ * attention masked first; on again, the controller is initialised from
+ * scratch. */
+static bool rail_off;
+static bool rmi4_init(void);
+bool touch_rmi4_rail(bool off)
+{
+	if (!present && !rail_off)
+		return false;
+	if (off == rail_off)
+		return true;
+	if (off) {
+		tlmm_irq_enable(GPIO_ATTN, false);
+		if (rpm_regulator_both(RPM_LDOA, 19, false))
+			return false;
+		rail_off = true;
+		present = false;
+		sensor_asleep = false;
+	} else {
+		rail_off = false;
+		rpm_regulator_sleep_enable(RPM_LDOA, 19, true);
+		if (!rmi4_init())
+			return false;
+	}
+	log_printf("touch: supply %s\n", off ? "off" : "on, controller initialised");
+	return true;
+}
+bool touch_rmi4_rail_is_off(void) { return rail_off; }
