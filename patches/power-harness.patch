+
+/* Harness: the apps processor's bus clock votes zeroed in the sleep set
+ * (KHz only, as the vendor's rate clocks send) and its GCC sleep-enable
+ * vote cleared; off, the sleep set repeats the active rates and the vote
+ * is put back. Returns whether every request was acknowledged. */
+#define APCS_CLOCK_SLEEP_ENA_VOTE	0xfc401488u
+static int bus_sleep = -1;
+bool rpm_sleep_bus(bool on)
+{
+	static uint32_t saved_vote = 0xffffffffu;
+	static const struct { uint32_t type, id, khz; } clk[] = {
+		{ RPM_CLK2, 0, 200000 }, { RPM_CLK1, 1, 100000 }, { RPM_CLK1, 0, 50000 }, { RPM_CLK1, 2, 50000 },
+	};
+	if (bus_sleep == on)
+		return true;
+	bool ok = true;
+	for (unsigned i = 0; i < 4; i++) {
+		uint32_t kvp[3] = { RPM_KEY_KHZ, 4, on ? 0 : clk[i].khz };
+		if (request(RPM_SET_SLEEP, clk[i].type, clk[i].id, kvp, 1))
+			ok = false;
+	}
+	if (saved_vote == 0xffffffffu)
+		saved_vote = readl(APCS_CLOCK_SLEEP_ENA_VOTE);
+	writel(on ? 0 : saved_vote, APCS_CLOCK_SLEEP_ENA_VOTE);
+	if (ok)
+		bus_sleep = on;
+	log_printf("rpm: bus sleep votes %s%s, gcc sleep vote %08lx (saved %08lx)\n", on ? "zero" : "active rates",
+		   ok ? "" : " NOT all acknowledged", readl(APCS_CLOCK_SLEEP_ENA_VOTE), saved_vote);
+	return ok;
+}
