+ * PLL: with it in low power mode for sleep the chip reset shortly after,
+ * with no record. */
+static const uint8_t lpm_ldos[] = { 4, 6 };
+static int8_t lpm_active_hpm[sizeof lpm_ldos];
+static int ldo_sleep = -1;
+bool rpm_ldo_sleep_lpm(bool on)
+{
+	if (ldo_sleep == on)
+		return true;
+	bool ok = true;
+	for (unsigned i = 0; i < sizeof lpm_ldos; i++) {
+		if (!lpm_active_hpm[i])
+			lpm_active_hpm[i] = (pmic_read(0x014000 + 0x100 * (lpm_ldos[i] - 1) + 0x45) & 0x80) ? 1 : -1;
