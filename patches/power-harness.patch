+/* powertest <settle_min> <arm_min>: from the unplug, a settle, then arms
+ * of fast and slow connection parameters and Bluetooth off, round and
+ * round until the cable is back, each logged. */
+static uint32_t pt_t0, pt_settle_ms, pt_arm_ms;
+static int pt_arm = -1;
+static bool pt_waiting, pt_lpm, pt_dsi;
+
+static void cmd_powertest(const char *args)
+{
+	uint32_t settle, arm;
+	if (!parse_num(&args, 10, &settle) || !parse_num(&args, 10, &arm)) {
+		say("usage: powertest <settle_min> <arm_min>\n");
+		return;
+	}
+	while (*args == ' ')
+		args++;
+	pt_lpm = !strcmp(args, "lpm");
+	pt_dsi = !strcmp(args, "dsi");
+	pt_settle_ms = settle * 60000;
+	pt_arm_ms = arm * 60000;
+	pt_waiting = true;
+	pt_arm = -1;
+	log_printf("powertest: settle %lu min, arms %lu min, from each unplug\n", settle, arm);
+	say("powertest armed, unplug to start\n");
+}
+
+static void powertest_bt(bool on)
+{
+	struct bt_info info;
+	uint8_t addr[6];
+	bt_host_stop();
+	bt_stop();
+	if (!on)
+		return;
+	bool have_addr = !bt_addr_load(addr);
+	if (bt_start(have_addr ? addr : NULL, &info))
+		log_printf("powertest: bt %s failed (%d)\n", info.failed, info.status);
+	else if (bt_host_start())
+		log_printf("powertest: bt host failed\n");
+}
+
+static void powertest_poll(void)
+{
+	static const char *const names[] = { "fast", "slow", "bt off" };
+	static uint32_t checked;
+	if (pt_arm < 0 && !pt_waiting)
+		return;
+	/* The charger state is a PMIC read, once a second is plenty. */
+	if (time_ms() - checked < 1000)
+		return;
+	checked = time_ms();
+	if (pt_waiting) {
+		if (pmic_usb_present())
+			return;
+		pt_waiting = false;
+		pt_t0 = time_ms();
+		pt_arm = 0;
+		log_printf("powertest: unplugged, settling\n");
+	}
+	if (pt_arm < 0)
+		return;
+	if (pmic_usb_present()) {
+		log_printf("powertest: plugged in, waiting for the next unplug\n");
+		pt_arm = -1;
+		pt_waiting = true;
+		if (!bt_host_running())
+			powertest_bt(true);
+		display_set_rest_level(2);
+		return;
+	}
+	uint32_t at = pt_settle_ms + (uint32_t)pt_arm * pt_arm_ms;
+	if (time_ms() - pt_t0 < at)
+		return;
+	if (pt_lpm) {
+		bool lpm = pt_arm % 2 == 0;
+		pmic_batfet_lpm(lpm);
+		log_printf("powertest: arm %d batfet lpm %s, ctrl4 %02x\n", pt_arm, lpm ? "on" : "off", pmic_read(0x001293));
+		pt_arm++;
+		return;
+	}
+	if (pt_dsi) {
+		/* Bluetooth off, the three rests mirrored: collapse, PLL off,
+		 * as before, as before, PLL off, collapse. */
+		static const int8_t order[] = { 2, 1, 0, 0, 1, 2 };
+		static const char *const names[] = { "rest=old", "rest=pll", "rest=collapse" };
+		if (pt_arm == 0)
+			powertest_bt(false);
+		display_set_rest_level(order[pt_arm % 6]);
+		log_printf("powertest: arm %d %s aod=%s bt=off\n", pt_arm, names[display_rest_level],
+			   setting_get(SETTING_AOD) ? "on" : "off");
+		pt_arm++;
+		return;
+	}
+	int kind = pt_arm % 3;
+	log_printf("powertest: arm %d %s\n", pt_arm, names[kind]);
+	if (kind == 2)
+		powertest_bt(false);
+	else {
+		if (!bt_host_running())
+			powertest_bt(true);
+		bt_host_slow(kind == 1);
+	}
+	pt_arm++;
+}
+
 void console_poll(void)
 {
+	powertest_poll();
 	if (running) {
 		if (more && more())
 			return;
