+
+/* Harness (C): with the card asleep its VCC, L17, off as well, as the
+ * vendor's host power off; L6 stays. Back on takes the full
+ * identification; partitions and the write guard stay as they were. */
+static bool vcc_wanted, vcc_off;
+static void vcc_cut(void)
+{
+	if (rpm_regulator_both(RPM_LDOA, 17, false))
+		log_printf("emmc: vcc off NOT acknowledged\n");
+	else
+		vcc_off = true;
+	log_printf("emmc: vcc off, l17 %02x\n", pmic_read(0x015046));
+}
+
+static int vcc_restore(void)
+{
+	unsigned n = nparts, g = nguard;
+	uint32_t gf = guard_first, gc = guard_count;
+	rpm_regulator_both(RPM_LDOA, 17, true);
+	vcc_off = false;
+	card_asleep = false;
+	delay_ms(1);
+	int r = emmc_init(true);
+	if (!r) {
+		nparts = n;
+		nguard = g;
+		guard_first = gf;
+		guard_count = gc;
+	}
+	log_printf("emmc: vcc on, l17 %02x, card %s\n", pmic_read(0x015046), r ? "lost" : "back");
+	return r;
+}
+
+bool emmc_rail(bool off)
+{
+	vcc_wanted = off;
+	if (off && card_asleep && !vcc_off)
+		vcc_cut();
+	else if (!off && vcc_off)
+		vcc_restore();
+	return vcc_off;
+}
+uint32_t emmc_idle_ms(void) { return time_ms() - last_io_ms; }
+
+static bool branch_on(uint32_t cbcr)
+{
+	writel(readl(cbcr) | BIT(0), cbcr);
+	return wait_clear(cbcr, BIT(31), 1000);
+}
+
+int emmc_sleep(bool on)
+{
+	if (!card.ready || on == card_asleep)
+		return card.ready ? 0 : -1;
+	int r;
+	if (on) {
+		if ((r = wait_tran(1000)))
+			goto fail;
+		if ((card.ext_csd[33] & 1) && (r = ext_csd_switch(SWITCH_WRITE_BYTE, 32, 1)))
+			goto fail;
+		if ((r = cmd(7, 0, R_NONE, NULL)))
+			goto fail;
+		if ((r = cmd(5, RCA << 16 | BIT(15), R1B, NULL))) {
+			cmd(7, RCA << 16, R1B, NULL);
+			goto fail;
+		}
+		hc_ww((uint16_t)(hc_rw(HC_CLK) & ~CLK_SD_EN), HC_CLK);
+		writel(readl(GCC_SDCC1_APPS_CBCR) & ~BIT(0), GCC_SDCC1_APPS_CBCR);
+		writel(readl(GCC_SDCC1_AHB_CBCR) & ~BIT(0), GCC_SDCC1_AHB_CBCR);
+		card_asleep = true;
+		if (vcc_wanted)
+			vcc_cut();
+	} else {
+		if (vcc_off)
+			return vcc_restore();
+		if (!branch_on(GCC_SDCC1_AHB_CBCR) || !branch_on(GCC_SDCC1_APPS_CBCR)) {
