+
+/* Harness: the peripheral LDOs left in high-power mode by their active
+ * votes asked for the load-following mode (lsmd 0, IPEAK) with a small
+ * load in the sleep set; off, the sleep set repeats each rail's active
+ * mode as read from the PMIC. MX (L3) and the USB rails are left alone. */
+#define RPM_KEY_LSMD	0x646d736cu
+#define RPM_KEY_MA	0x0000616du
