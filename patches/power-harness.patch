+/* powertest <settle_min> <arm_min>: from the unplug, a settle, then arms
+ * of fast and slow connection parameters and Bluetooth off, round and
+ * round until the cable is back, each logged. */
+static uint32_t pt_t0, pt_settle_ms, pt_arm_ms;
+static int pt_arm = -1;
+static bool pt_waiting, pt_lpm, pt_dsi, pt_sleep, pt_floor, pt_night;
+
+static void cmd_powertest(const char *args)
+{
+	uint32_t settle, arm;
+	if (!parse_num(&args, 10, &settle) || !parse_num(&args, 10, &arm) || !arm || arm > 600 || settle > 600) {
+		say("usage: powertest <settle_min> <arm_min 1-600> [lpm|dsi|sleep|floor|night]\n");
+		return;
+	}
+	while (*args == ' ')
+		args++;
+	if (*args && strcmp(args, "lpm") && strcmp(args, "dsi") && strcmp(args, "sleep") && strcmp(args, "floor") &&
+	    strcmp(args, "night")) {
+		say("powertest: unknown mode %s\n", args);
+		return;
+	}
+	pt_usb_undo = 0;
+	pt_lpm = !strcmp(args, "lpm");
+	pt_dsi = !strcmp(args, "dsi");
+	pt_sleep = !strcmp(args, "sleep") || !strcmp(args, "floor");
+	pt_floor = !strcmp(args, "floor");
+	pt_night = !strcmp(args, "night");
+	if (pt_night)
+		pt_sleep = true;
+	pt_settle_ms = settle * 60000;
+	pt_arm_ms = arm * 60000;
+	pt_waiting = true;
+	pt_arm = -1;
+	log_printf("powertest: settle %lu min, arms %lu min, from each unplug\n", settle, arm);
+	say("powertest armed, unplug to start\n");
+}
+
+static void powertest_bt(bool on)
+{
+	struct bt_info info;
+	uint8_t addr[6];
+	bt_host_stop();
+	bt_stop();
+	if (!on)
+		return;
+	bool have_addr = !bt_addr_load(addr);
+	if (bt_start(have_addr ? addr : NULL, &info))
+		log_printf("powertest: bt %s failed (%d)\n", info.failed, info.status);
+	else if (bt_host_start())
+		log_printf("powertest: bt host failed\n");
+}
+
+/* The sleep measures of `powertest ... sleep`: USB PHY low power, RPM bus
+ * sleep votes and the GCC sleep vote, hub held in reset, eMMC asleep,
+ * touch sensor asleep. USB goes first on the way back. */
+
+/* Each measure keeps its own state and is a no-op when already there;
+ * pt_applied holds what actually took effect. */
+static void powertest_measures(unsigned m)
+{
+	pt_want = m;
+	unsigned have = 0;
+	if (usb_phy_lpm(m & PT_USB) ? (m & PT_USB) : !(m & PT_USB))
+		have |= PT_USB;
+	if (rpm_sleep_bus(m & PT_RPM) && (m & PT_RPM))
+		have |= PT_RPM;
+	if (hub_hold(m & PT_HUB) && (m & PT_HUB))
+		have |= PT_HUB;
+	if (!(m & PT_EMMCRAIL))
+		emmc_rail(false);
+	if (!emmc_sleep(m & PT_EMMC) && emmc_is_asleep())
+		have |= PT_EMMC;
+	if ((m & PT_EMMCRAIL) && emmc_rail(true))
+		have |= PT_EMMCRAIL;
+	if (touch_rmi4_gesture(m & PT_GESTURE) && (m & PT_GESTURE))
+		have |= PT_GESTURE;
+	/* The touch supply goes off after the sensor sleeps and comes back
+	 * (with the controller initialised again) before it wakes. */
+	if (!(m & PT_TOUCHRAIL) && touch_rmi4_rail(false) && !(m & PT_TOUCH))
+		touch_rmi4_sleep(false);
+	if (touch_rmi4_rail_is_off() || (touch_rmi4_sleep(m & PT_TOUCH) && (m & PT_TOUCH)))
+		have |= m & PT_TOUCH;
+	if ((m & PT_TOUCHRAIL) && touch_rmi4_rail(true))
+		have |= PT_TOUCHRAIL;
+	usb_rails_policy(m & PT_USBRAIL);
+	if ((m & PT_USBRAIL) && usb_rails_are_off())
+		have |= PT_USBRAIL;
+	if (rpm_ldo_sleep_lpm(m & PT_LDO) && (m & PT_LDO))
+		have |= PT_LDO;
+	if (speaker_powerdown(m & PT_AMP) && (m & PT_AMP))
+		have |= PT_AMP;
+	if (rpm_sd_rails(m & PT_SDRAIL) && (m & PT_SDRAIL))
+		have |= PT_SDRAIL;
+	display_set_rails(m & PT_PANELRAIL);
+	display_set_deep(m & PT_PANEL);
+	if ((m & PT_PANELRAIL) && display_rails_are_off())
+		have |= PT_PANELRAIL;
+	if ((m & PT_PANEL) && display_is_deep())
+		have |= PT_PANEL;
+	/* S needs the hub running: it comes up after a release from reset. */
+	if (hub_services((m & PT_HUBSVC) && !(m & PT_HUB)) && (m & PT_HUBSVC) && hub_services_are_off())
+		have |= PT_HUBSVC;
+	have = (have & ~PT_USB) | (usb_phy_in_lpm() ? PT_USB : 0);
+	/* U only rests USB once unplugged; V needs that too. */
+	if (pmic_usb_present())
+		have |= m & (PT_USB | PT_USBRAIL);
+	if (have != pt_applied || have != m)
+		log_printf("powertest: measures want %03x have %03x\n", m, have);
+	pt_applied = have;
+}
+
+static bool hub_ready_or_held(void)
+{
+	return (pt_want & PT_HUB) || hub_ready();
+}
+
+uint32_t powertest_next_ms(void)
+{
+	if (pt_arm < 0)
+		return UINT32_MAX;
+	uint32_t at = pt_settle_ms + (uint32_t)pt_arm * pt_arm_ms, gone = time_ms() - pt_t0;
+	return gone >= at ? 1 : at - gone;
+}
+
+static void powertest_poll(void)
+{
+	static const char *const names[] = { "fast", "slow", "bt off" };
+	static uint32_t checked;
+	if (pt_arm < 0 && !pt_waiting)
+		return;
+	/* The charger state is a PMIC read, once a second is plenty. */
+	if (time_ms() - checked < 1000)
+		return;
+	checked = time_ms();
+	if (pt_waiting) {
+		if (pmic_usb_present())
+			return;
+		pt_waiting = false;
+		pt_t0 = time_ms();
+		pt_arm = 0;
+		log_printf("powertest: unplugged, settling\n");
+	}
+	if (pt_arm < 0)
+		return;
+	if (pmic_usb_present()) {
+		log_printf("powertest: plugged in, waiting for the next unplug\n");
+		pt_arm = -1;
+		pt_waiting = true;
+		if (!bt_host_running())
+			powertest_bt(true);
+		display_set_rest_level(2);
+		if (pt_sleep)
+			powertest_measures(0);
+		return;
+	}
+	/* Within an arm, put back what other code undid: a transfer wakes
+	 * the eMMC (the hub reads its calibration after a release), and a
+	 * measure that failed is tried again. */
+	if (pt_sleep && pt_arm > 0 && ((pt_want & ~pt_applied) || ((pt_want & PT_EMMC) && !emmc_is_asleep())) &&
+	    (!(pt_want & PT_EMMC) || emmc_idle_ms() > 3000) && hub_ready_or_held())
+		powertest_measures(pt_want);
+	uint32_t at = pt_settle_ms + (uint32_t)pt_arm * pt_arm_ms;
+	if (time_ms() - pt_t0 < at)
+		return;
+	if (pt_lpm) {
+		bool lpm = pt_arm % 2 == 0;
+		pmic_batfet_lpm(lpm);
+		log_printf("powertest: arm %d batfet lpm %s, ctrl4 %02x\n", pt_arm, lpm ? "on" : "off", pmic_read(0x001293));
+		pt_arm++;
+		return;
+	}
+	if (pt_night) {
+		/* B = the five sleep measures; G = B with touch in the
+		 * vendor's gesture doze; L = B plus the panel in deep standby
+		 * with its supplies off; C = B plus the card's VCC off; V = B
+		 * plus the USB PHY supplies off. */
+		enum { B = PT_ALL, G = (PT_ALL & ~PT_TOUCH) | PT_GESTURE, L = PT_ALL | PT_PANEL | PT_PANELRAIL, C = PT_ALL | PT_EMMCRAIL,
+		       V = PT_ALL | PT_USBRAIL };
+		static const uint16_t order[] = { B, G, G, B, B, L, L, B, B, C, C, B, B, V, V, B };
+		if (pt_arm == 0)
+			powertest_bt(false);
+		else
+			log_printf("powertest: arm %d end, have %03x\n", pt_arm - 1, pt_applied);
+		unsigned m = order[pt_arm % ARRAY_SIZE(order)];
+		powertest_measures(m);
+		log_printf("powertest: arm %d night=%03x aod=%s bt=off have %03x\n", pt_arm, m, setting_get(SETTING_AOD) ? "on" : "off",
+			   pt_applied);
+		pt_arm++;
+		return;
+	}
+	if (pt_floor) {
+		/* Bluetooth off; B = the five sleep measures. Each new measure
+		 * between two B arms, then the same in reverse, then B against
+		 * all of them, ABBA. */
+		enum { B = PT_ALL, F = PT_ALL | PT_USBRAIL | PT_TOUCHRAIL | PT_LDO };
+		static const uint16_t order[] = { B, B | PT_USBRAIL, B, B | PT_TOUCHRAIL, B, B | PT_LDO, B, F,
+						  F, B, B | PT_LDO, B, B | PT_TOUCHRAIL, B, B | PT_USBRAIL, B,
+						  B, F, F, B };
+		if (pt_arm == 0)
+			powertest_bt(false);
