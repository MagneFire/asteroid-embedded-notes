+/* powertest <settle_min> <arm_min>: from the unplug, a settle, then arms
+ * of fast and slow connection parameters and Bluetooth off, round and
+ * round until the cable is back, each logged. */
+static uint32_t pt_t0, pt_settle_ms, pt_arm_ms;
+static int pt_arm = -1;
+static bool pt_waiting, pt_lpm, pt_dsi, pt_sleep;
+
+static void cmd_powertest(const char *args)
+{
+	uint32_t settle, arm;
+	if (!parse_num(&args, 10, &settle) || !parse_num(&args, 10, &arm) || !arm || arm > 600 || settle > 600) {
+		say("usage: powertest <settle_min> <arm_min 1-600> [lpm|dsi|sleep]\n");
+		return;
+	}
+	while (*args == ' ')
+		args++;
+	if (*args && strcmp(args, "lpm") && strcmp(args, "dsi") && strcmp(args, "sleep")) {
+		say("powertest: unknown mode %s\n", args);
+		return;
+	}
+	pt_usb_undo = 0;
+	pt_lpm = !strcmp(args, "lpm");
+	pt_dsi = !strcmp(args, "dsi");
+	pt_sleep = !strcmp(args, "sleep");
+	pt_settle_ms = settle * 60000;
+	pt_arm_ms = arm * 60000;
+	pt_waiting = true;
+	pt_arm = -1;
+	log_printf("powertest: settle %lu min, arms %lu min, from each unplug\n", settle, arm);
+	say("powertest armed, unplug to start\n");
+}
+
+static void powertest_bt(bool on)
+{
+	struct bt_info info;
+	uint8_t addr[6];
+	bt_host_stop();
+	bt_stop();
+	if (!on)
+		return;
+	bool have_addr = !bt_addr_load(addr);
+	if (bt_start(have_addr ? addr : NULL, &info))
+		log_printf("powertest: bt %s failed (%d)\n", info.failed, info.status);
+	else if (bt_host_start())
+		log_printf("powertest: bt host failed\n");
+}
+
+/* The sleep measures of `powertest ... sleep`: USB PHY low power, RPM bus
+ * sleep votes and the GCC sleep vote, hub held in reset, eMMC asleep,
+ * touch sensor asleep. USB goes first on the way back. */
+
+/* Each measure keeps its own state and is a no-op when already there;
+ * pt_applied holds what actually took effect. */
+static void powertest_measures(unsigned m)
+{
+	pt_want = m;
+	unsigned have = 0;
+	if (usb_phy_lpm(m & PT_USB) ? (m & PT_USB) : !(m & PT_USB))
+		have |= PT_USB;
+	if (rpm_sleep_bus(m & PT_RPM) && (m & PT_RPM))
+		have |= PT_RPM;
+	if (hub_hold(m & PT_HUB) && (m & PT_HUB))
+		have |= PT_HUB;
+	if (!emmc_sleep(m & PT_EMMC) && emmc_is_asleep())
+		have |= PT_EMMC;
+	if (touch_rmi4_sleep(m & PT_TOUCH) && (m & PT_TOUCH))
+		have |= PT_TOUCH;
+	have = (have & ~PT_USB) | (usb_phy_in_lpm() ? PT_USB : 0);
+	if (have != pt_applied || have != m)
+		log_printf("powertest: measures want %02x have %02x\n", m, have);
+	pt_applied = have;
+}
+
+static bool hub_ready_or_held(void)
+{
+	return (pt_want & PT_HUB) || hub_ready();
+}
+
+uint32_t powertest_next_ms(void)
+{
+	if (pt_arm < 0)
+		return UINT32_MAX;
+	uint32_t at = pt_settle_ms + (uint32_t)pt_arm * pt_arm_ms, gone = time_ms() - pt_t0;
+	return gone >= at ? 1 : at - gone;
+}
+
+static void powertest_poll(void)
+{
+	/* After the PHY has been in low power mode the USB stack does not
+	 * get the host back (the host does not enumerate it again), so on
+	 * plug-in, or when a manual test's 10 s are up, the watch reboots to
+	 * the bootloader, where the log is read; the log survives. */
+	static bool usb_lpm_used;
+	if (usb_phy_in_lpm())
+		usb_lpm_used = true;
+	if (usb_lpm_used && ((pt_usb_undo && (int32_t)(time_ms() - pt_usb_undo) >= 0) || (!pt_usb_undo && pmic_usb_present()))) {
+		log_printf("powertest: usb phy was in lpm, rebooting to the bootloader\n");
+		reboot_to_bootloader = true;
+		reboot();
+	}
+	static const char *const names[] = { "fast", "slow", "bt off" };
+	static uint32_t checked;
+	if (pt_arm < 0 && !pt_waiting)
+		return;
+	/* The charger state is a PMIC read, once a second is plenty. */
+	if (time_ms() - checked < 1000)
+		return;
+	checked = time_ms();
+	if (pt_waiting) {
+		if (pmic_usb_present())
+			return;
+		pt_waiting = false;
+		pt_t0 = time_ms();
+		pt_arm = 0;
+		log_printf("powertest: unplugged, settling\n");
+	}
+	if (pt_arm < 0)
+		return;
+	if (pmic_usb_present()) {
+		log_printf("powertest: plugged in, waiting for the next unplug\n");
+		pt_arm = -1;
+		pt_waiting = true;
+		if (!bt_host_running())
+			powertest_bt(true);
+		display_set_rest_level(2);
+		if (pt_sleep)
+			powertest_measures(0);
+		return;
+	}
+	/* Within an arm, put back what other code undid: a transfer wakes
+	 * the eMMC (the hub reads its calibration after a release), and a
+	 * measure that failed is tried again. */
+	if (pt_sleep && pt_arm > 0 && ((pt_want & ~pt_applied) || ((pt_want & PT_EMMC) && !emmc_is_asleep())) &&
+	    (!(pt_want & PT_EMMC) || emmc_idle_ms() > 3000) && hub_ready_or_held())
+		powertest_measures(pt_want);
+	uint32_t at = pt_settle_ms + (uint32_t)pt_arm * pt_arm_ms;
+	if (time_ms() - pt_t0 < at)
+		return;
+	if (pt_lpm) {
+		bool lpm = pt_arm % 2 == 0;
+		pmic_batfet_lpm(lpm);
+		log_printf("powertest: arm %d batfet lpm %s, ctrl4 %02x\n", pt_arm, lpm ? "on" : "off", pmic_read(0x001293));
+		pt_arm++;
+		return;
+	}
+	if (pt_sleep) {
+		/* Bluetooth off, leave-one-out mirrored: all measures, each one
+		 * left out in turn, none; then back. */
+		static const uint8_t order[] = { PT_ALL, PT_ALL & ~PT_USB, PT_ALL & ~PT_RPM, PT_ALL & ~PT_HUB, PT_ALL & ~PT_EMMC,
+						 PT_ALL & ~PT_TOUCH, 0, 0, PT_ALL & ~PT_TOUCH, PT_ALL & ~PT_EMMC, PT_ALL & ~PT_HUB,
+						 PT_ALL & ~PT_RPM, PT_ALL & ~PT_USB, PT_ALL };
+		if (pt_arm == 0)
+			powertest_bt(false);
+		else
+			log_printf("powertest: arm %d end, have %02x\n", pt_arm - 1, pt_applied);
+		unsigned m = order[pt_arm % ARRAY_SIZE(order)];
+		powertest_measures(m);
+		log_printf("powertest: arm %d sleep=%s%s%s%s%s aod=%s bt=off have %02x\n", pt_arm, m & PT_USB ? "U" : "-",
+			   m & PT_RPM ? "R" : "-", m & PT_HUB ? "H" : "-", m & PT_EMMC ? "E" : "-", m & PT_TOUCH ? "T" : "-",
+			   setting_get(SETTING_AOD) ? "on" : "off", pt_applied);
+		pt_arm++;
+		return;
+	}
+	if (pt_dsi) {
+		/* Bluetooth off, the three rests mirrored: collapse, PLL off,
+		 * as before, as before, PLL off, collapse. */
+		static const int8_t order[] = { 2, 1, 0, 0, 1, 2 };
+		static const char *const names[] = { "rest=old", "rest=pll", "rest=collapse" };
+		if (pt_arm == 0)
+			powertest_bt(false);
+		display_set_rest_level(order[pt_arm % 6]);
+		log_printf("powertest: arm %d %s aod=%s bt=off\n", pt_arm, names[display_rest_level],
+			   setting_get(SETTING_AOD) ? "on" : "off");
+		pt_arm++;
+		return;
+	}
+	int kind = pt_arm % 3;
+	log_printf("powertest: arm %d %s\n", pt_arm, names[kind]);
+	if (kind == 2)
+		powertest_bt(false);
+	else {
+		if (!bt_host_running())
+			powertest_bt(true);
+		bt_host_slow(kind == 1);
+	}
+	pt_arm++;
+}
+
