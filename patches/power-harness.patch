+bool touch_rmi4_sleep(bool on)
+{
+	if (!present)
+		return false;
+	if (on == sensor_asleep)
+		return true;
+	uint8_t v = 0, st[2];
+	if (on) {
+		tlmm_irq_enable(GPIO_ATTN, false);
+		if (rd(f01.ctrl, &v, 1) || wr(f01.ctrl, (uint8_t)((v & ~7) | 1)))
+			goto fail;
+		f01_ctrl_saved = v;
+	} else {
+		if (rd(f01.ctrl, &v, 1) || wr(f01.ctrl, (uint8_t)((v & ~7) | (f01_ctrl_saved & 4))))
+			goto fail;
+		rd(f01.data, st, 2);
+		tlmm_irq_enable(GPIO_ATTN, true);
+	}
+	sensor_asleep = on;
+	rd(f01.ctrl, &v, 1);
+	log_printf("touch: sensor %s, ctrl %02x\n", on ? "asleep" : "awake", v);
+	return true;
+fail:
+	if (!sensor_asleep)
+		tlmm_irq_enable(GPIO_ATTN, true);
+	log_printf("touch: sensor %s failed\n", on ? "sleep" : "wake");
+	return false;
