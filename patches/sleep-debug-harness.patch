+static void cmd_pw(const char *args)
+{
+	uint32_t addr, v;
+	if (parse_num(&args, 16, &addr) && parse_num(&args, 16, &v))
+		pmic_write(addr, v);
+	say("%05lx = %02x\n", addr, pmic_read(addr));
+}
+
+static uint32_t fourcc(const char **args)
+{
+	*args = skip_spaces(*args);
+	uint32_t v = 0;
+	for (int i = 0; i < 4 && **args && **args != ' '; i++)
+		v |= (uint32_t)(uint8_t)*(*args)++ << (8 * i);
+	return v;
+}
+
+int rpm_debug_request(uint32_t set, uint32_t type, uint32_t id, uint32_t key, uint32_t val);
+
+static void cmd_rpm(const char *args)
+{
+	uint32_t set, id, val;
+	if (!parse_num(&args, 0, &set))
+		return;
+	uint32_t type = fourcc(&args);
+	if (!parse_num(&args, 0, &id))
+		return;
+	uint32_t key = fourcc(&args);
+	if (!parse_num(&args, 0, &val))
+		return;
+	say("rpm %lu %08lx %lu %08lx %lu -> %d\n", set, type, id, key, val, rpm_debug_request(set, type, id, key, val));
+}
+
+extern volatile uint32_t deep_until;
+
+static void cmd_deep(const char *args)
+{
+	uint32_t s = 20;
+	parse_num(&args, 0, &s);
+	pmic_write(0x1347, 1);
+	deep_until = time_ms() + s * 1000;
+	power_request(true);
+}
+
+static void cmd_gpio(const char *args)
+{
+	uint32_t n, cfg, io;
+	if (!parse_num(&args, 0, &n) || !parse_num(&args, 16, &cfg) || !parse_num(&args, 16, &io))
+		return;
+	writel(io, TLMM_GPIO_IO(n));
+	writel(cfg, TLMM_GPIO_CFG(n));
+	say("gpio %lu: %08lx %08lx\n", n, readl(TLMM_GPIO_CFG(n)), readl(TLMM_GPIO_IO(n)));
+}
+
 static void cmd_echo(const char *args)
 {
 	say("%s\n", args);
